# Copy to .env.local. All values are optional.
NEXT_PUBLIC_SITE_URL=https://plotledge.com
NEXT_PUBLIC_CRM_URL=https://realestatemanager-chi.vercel.app/login

# Lead form endpoint (Formspree-style). Leave empty in development to log submissions to the console.
LEAD_WEBHOOK_URL=
# PLACEHOLDER: replace with the real WhatsApp number, digits only, international format.
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000
# PLACEHOLDER: replace with the real contact email.
NEXT_PUBLIC_CONTACT_EMAIL=hello@plotledge.com
# PLACEHOLDER: replace with the real phone number shown on the site.
NEXT_PUBLIC_CONTACT_PHONE=+92 300 0000000
