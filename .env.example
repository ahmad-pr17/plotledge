# Copy to .env.local for local work. On Vercel, add the same names under
# Project Settings > Environment Variables, then redeploy.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://www.plotledge.com
NEXT_PUBLIC_CRM_URL=https://realestatemanager-chi.vercel.app/login

# Contact details shown on the site and used by the WhatsApp buttons.
# WhatsApp number: digits only, international format, for example 923001234567.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# ---- Chat assistant (server side only, never exposed to the browser) ----
# Create a key at https://console.anthropic.com/ and keep it secret.
ANTHROPIC_API_KEY=
# Model used for replies. A small fast model keeps cost low.
CHAT_MODEL=claude-haiku-4-5-20251001

# ---- Where contact requests go (use either one, or both) ----
# Option A: a webhook (Formspree, Zapier, Make, a Google Apps Script URL, and so on).
LEAD_WEBHOOK_URL=
# Option B: email through Resend (https://resend.com). Needs RESEND_API_KEY and LEAD_EMAIL_TO.
LEAD_EMAIL_TO=
RESEND_API_KEY=
# Sender shown on the email. Use an address on a domain you verified in Resend.
LEAD_EMAIL_FROM=
